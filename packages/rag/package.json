{
  "name": "@copilot/rag",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first RAG (Retrieve-Augment-Generate) for Copilot app (Sprint 1.3 T-1.3.1). Embedding via Ollama bge-m3 (HTTP, local, 1024 dim), vector storage via sql.js (WASM SQLite — sqlite-vss fallback because Python 3.14 distutils block better-sqlite3 native build), answer streaming via @copilot/llm-client. 100% local — no cloud OpenAI (goal.md R5 + decision red line).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "SCHEMA-FROZEN-1.2.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:integration": "vitest run tests/rag-sources-pipeline.integration.test.ts",
    "test:coverage": "npm run test:coverage:global",
    "test:coverage:global": "vitest run --coverage --config vitest.coverage.config.ts --reporter=verbose",
    "test:coverage:critical": "vitest run --coverage --config vitest.critical.config.ts --reporter=verbose"
  },
  "dependencies": {
    "@copilot/llm-client": "0.1.0",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@types/sql.js": "1.4.11",
    "@types/node": "24.13.3",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  }
}
