{
  "name": "@copilot/rag",
  "version": "0.1.0",
  "private": true,
  "description": "Strict local-first RAG for Copilot: self-contained embedded-local hashing by default, explicit Ollama compatibility, durable local text fallback, model-scoped sql.js vectors, aligned answer sources.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "SCHEMA-FROZEN-1.2.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:integration": "vitest run tests/rag-sources-pipeline.integration.test.ts",
    "test:coverage": "npm run test:coverage:global",
    "test:coverage:global": "vitest run --coverage --config vitest.coverage.config.ts --reporter=verbose",
    "test:coverage:critical": "vitest run --coverage --config vitest.critical.config.ts --reporter=verbose"
  },
  "dependencies": {
    "@copilot/llm-client": "0.1.0",
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@types/sql.js": "1.4.9",
    "@types/node": "24.0.0",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  }
}
