{
  "name": "@copilot/kb",
  "version": "0.1.0",
  "private": true,
  "description": "Local KB persistence (SQLite + MD notes) + CRUD API for Copilot app. Cross-desktop/cloud shared package; Sprint 1.2 KG builder + Sprint 1.3 RAG consume this.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "SCHEMA-FROZEN-1.1.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:integration": "vitest run tests/e2e.test.ts",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "test:coverage:global": "vitest run --coverage --config vitest.config.ts --reporter=verbose",
    "test:coverage:critical": "vitest run --coverage --config vitest.critical-coverage.config.ts --reporter=verbose",
    "test:coverage:release": "vitest run --coverage --config vitest.release-coverage.config.ts --reporter=verbose",
    "test:perf": "vitest run tests/perf.test.ts --reporter=verbose",
    "test:e2e": "vitest run tests/e2e.test.ts --reporter=verbose"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "gray-matter": "4.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  }
}
