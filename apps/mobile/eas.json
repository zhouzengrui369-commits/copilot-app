{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "OPENCLAW_MOBILE_UPDATE_CHANNEL": "preview"
      }
    },
    "testflight": {
      "distribution": "store",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "env": {
        "OPENCLAW_MOBILE_UPDATE_CHANNEL": "preview",
        "OPENCLAW_MOBILE_DISTRIBUTION": "testflight"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {}
    },
    "production": {}
  }
}
