{
  "name": "@copilot/desktop",
  "productName": "njx-copilot-v6",
  "version": "0.1.0",
  "private": true,
  "description": "copilot app v6.1 — macOS Electron desktop shell (Sprint 1.1 T-1.1.1).",
  "author": {
    "name": "njx",
    "email": "zhouzengrui369@gmail.com"
  },
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "build:renderer": "vite build && node scripts/verify-renderer-bundle.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:main && npm run build:renderer",
    "check": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "dev:renderer": "vite",
    "preview:browser": "COPILOT_BROWSER_PROTOTYPE=1 VITE_COPILOT_BROWSER_PROTOTYPE=1 vite --host 127.0.0.1 --port 41744 --strictPort",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev": "node scripts/dev-desktop.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:release-evidence": "vitest run --config tests/vitest.release-evidence.config.ts",
    "test:integration": "vitest run tests/integration",
    "test:e2e:electron": "node scripts/run-electron-e2e.mjs",
    "test:coverage": "npm run test:coverage:global",
    "test:coverage:global": "vitest run --coverage --config tests/vitest.desktop-coverage.config.ts",
    "test:coverage:critical": "vitest run --coverage --config tests/vitest.critical-coverage.config.ts",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64 --config electron-builder.yml",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64 --config electron-builder.yml",
    "dist:mac:dir": "npm run build && electron-builder --mac --dir --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist:win:x64": "npm run build && electron-builder --win --x64 --config electron-builder.yml",
    "dist:win:arm64": "npm run build && electron-builder --win --arm64 --config electron-builder.yml"
  },
  "dependencies": {
    "@copilot/kb": "0.1.0",
    "@copilot/kg": "0.1.0",
    "@copilot/llm-client": "0.1.0",
    "@copilot/rag": "0.1.0",
    "@napi-rs/keyring": "1.3.0",
    "electron-store": "^8.2.0",
    "events": "^3.3.0",
    "graphology": "^0.25.4",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "sigma": "^3.0.0",
    "ws": "^8.21.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "acorn": "^8.16.0",
    "electron": "38.8.6",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8"
  }
}
