{
  "name": "openclaw-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/server",
    "apps/web",
    "apps/mobile",
    "apps/desktop",
    "apps/copilot-desktop",
    "apps/copilot-cloud",
    "packages/*"
  ],
  "scripts": {
    "backup:db": "node scripts/backup-db.mjs",
    "build": "npm run build --workspaces",
    "build:cloud": "npm run build --workspace @copilot/cloud",
    "build:desktop": "npm run build --workspace @openclaw-workbench/desktop",
    "check": "npm run check --workspaces",
    "check:cloud": "npm run check --workspace @copilot/cloud",
    "test:cloud": "npm run test --workspace @copilot/cloud",
    "test:cloud:coverage": "npm run test:coverage --workspace @copilot/cloud",
    "dev:cloud": "npm run dev --workspace @copilot/cloud",
    "dev": "npm run dev:all",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:desktop": "npm run dev:desktop --workspace @openclaw-workbench/desktop",
    "dev:server": "npm run dev --workspace @openclaw-workbench/server",
    "dev:web": "npm run dev --workspace @openclaw-workbench/web",
    "dev:copilot-desktop": "npm run dev --workspace @copilot/desktop",
    "check:copilot-desktop": "npm run check --workspace @copilot/desktop",
    "test:copilot-desktop": "npm run test --workspace @copilot/desktop",
    "dist:mac:copilot": "npm run dist:mac --workspace @copilot/desktop",
    "dist:mac": "npm run dist:mac --workspace @openclaw-workbench/desktop",
    "desktop:dev:install": "node scripts/desktop-dev-install.mjs",
    "desktop:dev:seed": "node --experimental-sqlite scripts/dev-seed-from-prod.mjs",
    "desktop:prod:promote": "node scripts/desktop-prod-promote.mjs",
    "health": "node scripts/health-check.mjs",
    "mobile:android:preview": "npm run android:preview --workspace @openclaw-workbench/mobile",
    "mobile:android:preview:local": "npm run android:preview:local --workspace @openclaw-workbench/mobile",
    "mobile:ios": "npm run ios --workspace @openclaw-workbench/mobile",
    "mobile:ios:expo-go": "npm run ios:expo-go --workspace @openclaw-workbench/mobile",
    "mobile:ios:submit:testflight": "npm run ios:submit:testflight --workspace @openclaw-workbench/mobile",
    "mobile:ios:testflight": "npm run ios:testflight --workspace @openclaw-workbench/mobile",
    "mobile:update:preview": "npm run update:preview --workspace @openclaw-workbench/mobile",
    "security:scan": "node scripts/security-scan.mjs",
    "start": "npm run start --workspace @openclaw-workbench/server",
    "test:e2e": "npm run test:e2e:web --",
    "test:e2e:web": "NODE_OPTIONS=--experimental-sqlite playwright test --config playwright.config.ts",
    "test:e2e:electron": "npm run test:e2e:electron --workspace @copilot/desktop --",
    "test:goal-os": "node scripts/goal-os-contract-smoke.mjs",
    "test:env-isolation": "node scripts/env-isolation-contract-smoke.mjs",
    "test:mobile-api": "node --experimental-sqlite scripts/mobile-api-smoke.mjs",
    "test:mobile-apk-release": "node scripts/mobile-apk-release-gate.mjs",
    "test:mobile-app": "npm run check --workspace @openclaw-workbench/mobile",
    "test:mobile-deployment-preflight": "node scripts/mobile-deployment-preflight.mjs",
    "test:mobile-ios-preflight": "node scripts/mobile-ios-preflight-smoke.mjs",
    "test:mobile-local-usability": "OPENCLAW_MOBILE_USABILITY_MODE=local node --experimental-sqlite scripts/mobile-usability-smoke.mjs",
    "test:mobile-p0-cloudbase-payload": "node scripts/mobile-p0-cloudbase-payload-smoke.mjs",
    "test:mobile-release": "node scripts/mobile-release-smoke.mjs",
    "test:mobile-transcription": "node scripts/mobile-transcription-provider-smoke.mjs",
    "test:mobile-ui-contract": "node scripts/mobile-ui-contract-smoke.mjs",
    "test:mobile-usability": "node --experimental-sqlite scripts/mobile-usability-smoke.mjs",
    "test:prd": "node --experimental-sqlite scripts/prd-v11-api-smoke.mjs",
    "test:truth": "node --experimental-sqlite scripts/truth-audit.mjs",
    "verify": "npm run verify:dev && npm run verify:desktop",
    "verify:desktop": "node scripts/desktop-packaged-verify.cjs",
    "verify:dev": "node scripts/web-dev-verify.cjs",
    "ci:local": "bash scripts/ci/run-ci-local.sh",
    "ci:lint": "bash scripts/ci/lint.sh",
    "ci:unit": "bash scripts/ci/unit-test.sh",
    "ci:integration": "bash scripts/ci/integration-test.sh",
    "ci:e2e": "bash scripts/ci/e2e-test.sh",
    "ci:screenshot-diff": "bash scripts/ci/screenshot-diff.sh",
    "ci:bench": "bash scripts/ci/bench-collect.sh",
    "ci:bench:validate": "node scripts/ci/bench-validate.mjs",
    "ci:bench:compare": "node scripts/ci/bench-compare.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "jsdom": "^25.0.1"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
